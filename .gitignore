# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables — never commit real secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Prisma generated client — regenerated by `npx prisma generate`, not source
backend/src/generated/
**/generated/prisma/

# Build output
frontend/dist/
frontend/build/
backend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Uploaded files (user content, not source — adjust if you want these tracked)
backend/uploads/
backend/src/uploads/

# Misc
*.local
coverage/
